{
  "version": 2,
  "builds": [
    {
      "src": "vercel_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "vercel_app.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings_prod",
    "DEBUG": "False",
    "ALLOWED_HOSTS": "*",
    "GEMINI_API_KEY": "@gemini-api-key"
  }
}